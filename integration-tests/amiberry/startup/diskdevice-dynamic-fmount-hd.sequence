C:fujinet-load-resident DEVS:fujinet-disk.device fujinet-disk.device
C:doslistdiag >DH0:dynamic-hd-pre.result
C:FMOUNT 14 DN0: RO >DH0:dynamic-hd-mount.result
C:Echo "FMOUNT HD RC=$RC" >>DH0:dynamic-hd-mount.result
C:doslistdiag >DH0:dynamic-hd-post-add.result
C:Dir DN0: >DH0:dynamic-hd-dir.result
C:Echo "DIR RC=$RC" >>DH0:dynamic-hd-dir.result
C:doslistdiag >DH0:dynamic-hd-post-dir.result
C:Type DN0:HD.TXT >DH0:dynamic-hd-type.result
C:Echo "TYPE RC=$RC" >>DH0:dynamic-hd-type.result
C:FLS host:/amiga-e2e-complete/diskdevice-dynamic-fmount-hd >NIL:
