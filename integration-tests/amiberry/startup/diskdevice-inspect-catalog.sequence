C:Echo "01 BEFORE LOAD RESIDENT"
C:fujinet-load-resident DEVS:fujinet-disk.device fujinet-disk.device
C:Echo "02 AFTER LOAD RESIDENT RC=$RC"

C:Echo "03 BEFORE FMOUNT"
C:fmount 11 DN0: RO >DH0:inspect-mount.result
C:Echo "04 AFTER FMOUNT RC=$RC"

C:Echo "05 BEFORE PRE DIR"
C:Dir DN0: >DH0:inspect-pre-dir.result
C:Echo "DIR RC=$RC" >>DH0:inspect-pre-dir.result
C:Echo "06 AFTER PRE DIR RC=$RC"

C:Echo "07 BEFORE PRE TYPE"
C:Type DN0:KNOWN.TXT >DH0:inspect-pre-type.result
C:Echo "TYPE RC=$RC" >>DH0:inspect-pre-type.result
C:Echo "08 AFTER PRE TYPE RC=$RC"

C:Echo "09 BEFORE PRE DOSLIST"
C:doslistdiag >DH0:inspect-pre-dos.result
C:Echo "10 AFTER PRE DOSLIST RC=$RC"

C:Echo "11 BEFORE PRE STATUS"
C:fujinet-mount --status 0 >DH0:inspect-pre-status.result
C:Echo "12 AFTER PRE STATUS RC=$RC"

C:Echo "13 BEFORE INSPECT HD"
C:diskinspect 0 14 >DH0:inspect-hd.result
C:Echo "INSPECT HD RC=$RC" >>DH0:inspect-hd.result
C:Echo "14 AFTER INSPECT HD RC=$RC"

C:Echo "15 BEFORE INSPECT DD"
C:diskinspect 0 11 >DH0:inspect-dd.result
C:Echo "INSPECT DD RC=$RC" >>DH0:inspect-dd.result
C:Echo "16 AFTER INSPECT DD RC=$RC"

C:Echo "17 BEFORE POST DOSLIST"
C:doslistdiag >DH0:inspect-post-dos.result
C:Echo "18 AFTER POST DOSLIST RC=$RC"

C:Echo "19 BEFORE POST STATUS"
C:fujinet-mount --status 0 >DH0:inspect-post-status.result
C:Echo "20 AFTER POST STATUS RC=$RC"

C:Echo "21 BEFORE POST DIR"
C:Dir DN0: >DH0:inspect-post-dir.result
C:Echo "DIR RC=$RC" >>DH0:inspect-post-dir.result
C:Echo "22 AFTER POST DIR RC=$RC"

C:Echo "23 BEFORE POST TYPE"
C:Type DN0:KNOWN.TXT >DH0:inspect-post-type.result
C:Echo "TYPE RC=$RC" >>DH0:inspect-post-type.result
C:Echo "24 AFTER POST TYPE RC=$RC"

C:Echo "25 BEFORE FLS"
C:FLS host:/amiga-e2e-complete/diskdevice-inspect-catalog >DH0:fls.result
C:Echo "26 AFTER FLS RC=$RC"
C:Echo "Exiting"
C:Echo "Exiting" > DH0:trace.result
