C:Assign T: RAM:
C:Echo "FUJINET WRITE PERSISTED" >DH0:persist-source.txt
C:FailAt 21
C:LoadModule DEVS:fujinet-disk.device
C:Echo "LOAD RC=$RC" >DH0:fmount-load.result
C:fmount 11 0 RO >DH0:fmount-mount.result
C:Echo "FMOUNT RC=$RC" >>DH0:fmount-mount.result
C:If NOT ERROR
C:Mount DN0: FROM DEVS:DN0
C:Wait 2 SECS
C:fujinet-mount --status 0 >DH0:fmount-status.result
C:Dir DN0: >DH0:fmount-dir.result
C:Echo "DIR RC=$RC" >>DH0:fmount-dir.result
C:Type DN0:KNOWN.TXT >DH0:fmount-type.result
C:fmount 13 2 RW >DH0:fmount-rw-mount.result
C:Echo "FMOUNT RW RC=$RC" >>DH0:fmount-rw-mount.result
C:If NOT ERROR
C:Mount DN2: FROM DEVS:DN2
C:Echo "DOS MOUNT 2 RC=$RC" >DH0:fmount-rw-dos-mount.result
C:Copy DH0:persist-source.txt TO DN2:PERSIST.TXT
C:Echo "COPY RC=$RC" >DH0:fmount-rw-copy.result
C:Assign DN2: DISMOUNT
C:Mount DN2: FROM DEVS:DN2
C:Echo "DOS REMOUNT 2 RC=$RC" >DH0:fmount-rw-remount.result
C:Type DN2:PERSIST.TXT >DH0:fmount-rw-persist.result
C:fujinet-mount --status 2 >DH0:fmount-rw-status.result
C:EndIf
C:fumount DN0: >DH0:fumount-eject.result
C:Echo "FUMOUNT RC=$RC" >>DH0:fumount-eject.result
C:fujinet-mount --status 0 >DH0:fumount-status.result
C:FLS host:/amiga-e2e-complete/diskdevice-fmount >NIL:
C:EndIf
C:Type DH0:fmount-load.result
C:Type DH0:fmount-mount.result
C:Type DH0:fmount-status.result
C:Type DH0:fmount-dir.result
C:Type DH0:fmount-type.result
C:Type DH0:fmount-rw-mount.result
C:Type DH0:fmount-rw-dos-mount.result
C:Type DH0:fmount-rw-copy.result
C:Type DH0:fmount-rw-remount.result
C:Type DH0:fmount-rw-persist.result
C:Type DH0:fmount-rw-status.result
C:Type DH0:fumount-eject.result
C:Type DH0:fumount-status.result
C:Echo "E2E COMPLETE"
