C:Assign T: RAM:
C:Echo "FUJINET WRITE PERSISTED" >DH0:persist-source.txt
C:FailAt 21
C:fujinet-load-resident DEVS:fujinet-disk.device fujinet-disk.device
C:Echo "LOAD RC=$RC" >DH0:fmount-load.result
C:fmount 11 0 RO >DH0:fmount-mount.result
C:Echo "FMOUNT RC=$RC" >>DH0:fmount-mount.result
C:If NOT ERROR
C:fujinet-mount --status 0 >DH0:fmount-status.result
C:Dir DN0: >DH0:fmount-dir.result
C:Echo "DIR RC=$RC" >>DH0:fmount-dir.result
C:Type DN0:KNOWN.TXT >DH0:fmount-type.result
C:FMOUNT 12 DN0: RO >DH0:fmount-ab-mount.result
C:fujinet-mount --status 0 >DH0:fmount-ab-present.result
C:Wait 1 SECS
C:Type DN0:SECOND.TXT >DH0:fmount-ab-type.result
C:FMOUNT 11 DN0: RO >DH0:fmount-ba-mount.result
C:fujinet-mount --status 0 >DH0:fmount-ba-present.result
C:Wait 1 SECS
C:Type DN0:KNOWN.TXT >DH0:fmount-ba-type.result
C:FMOUNT 14 DN0: RO >DH0:fmount-hd-mount.result
C:Echo "FMOUNT HD RC=$RC" >>DH0:fmount-hd-mount.result
C:Dir DN0: >DH0:fmount-hd-dir.result
C:Echo "DIR HD RC=$RC" >>DH0:fmount-hd-dir.result
C:Type DN0:HD.TXT >DH0:fmount-hd-type.result
C:Echo "TYPE HD RC=$RC" >>DH0:fmount-hd-type.result
C:doslistdiag >DH0:fmount-hd-dos.result
C:FMOUNT 11 DN0: RO >DH0:fmount-dd-return-mount.result
C:Echo "FMOUNT DD RETURN RC=$RC" >>DH0:fmount-dd-return-mount.result
C:Dir DN0: >DH0:fmount-dd-return-dir.result
C:Echo "DIR DD RETURN RC=$RC" >>DH0:fmount-dd-return-dir.result
C:Type DN0:KNOWN.TXT >DH0:fmount-dd-return-type.result
C:Echo "TYPE DD RETURN RC=$RC" >>DH0:fmount-dd-return-type.result
C:doslistdiag >DH0:fmount-dd-return-dos.result
C:FMOUNT 99 DN0: RO >DH0:fmount-failed-replace.result
C:Echo "FMOUNT FAILED RC=$RC" >>DH0:fmount-failed-replace.result
C:Wait 1 SECS
C:Type DN0:KNOWN.TXT >DH0:fmount-fail-type.result
C:fmount 13 2 RW >DH0:fmount-rw-mount.result
C:Echo "FMOUNT RW RC=$RC" >>DH0:fmount-rw-mount.result
C:If NOT ERROR
C:Copy DH0:persist-source.txt TO DN2:PERSIST.TXT
C:Echo "COPY RC=$RC" >DH0:fmount-rw-copy.result
C:fujinet-mount --status 2 >DH0:fmount-rw-status.result
C:Echo "STATUS RW RC=$RC" >>DH0:fmount-rw-status.result

C:Assign DN2: DISMOUNT

C:Echo "before-dn2-fumount" >DH0:fmount-rendezvous.marker
C:Ask "Diagnostic gate: press Return to FUMOUNT DN2"

C:FUMOUNT DN2: >DH0:fmount-rw-fumount.result
C:Echo "FUMOUNT RW RC=$RC" >>DH0:fmount-rw-fumount.result
C:Echo "after-dn2-fumount" >DH0:fmount-rw-fumount.done

C:fujinet-mount --status 2 >DH0:fmount-rw-absent.result
C:Echo "STATUS ABSENT RC=$RC" >>DH0:fmount-rw-absent.result
C:Echo "after-rw-absent" >DH0:fmount-rw-absent.done

C:FMOUNT 13 DN2: RW >DH0:fmount-rw-remount.result

C:Echo "FMOUNT RW REMOUNT RC=$RC" >>DH0:fmount-rw-remount.result
C:Echo "after-dn2-remount" >DH0:fmount-rw-remount.done
C:fujinet-mount --status 2 >DH0:fmount-rw-present.result
C:Echo "STATUS PRESENT RC=$RC" >>DH0:fmount-rw-present.result
C:Type DN2:PERSIST.TXT >DH0:fmount-rw-persist.result
C:Echo "TYPE PERSIST RC=$RC" >>DH0:fmount-rw-persist.result
C:EndIf
C:fumount DN0: >DH0:fumount-eject.result
C:Echo "FUMOUNT RC=$RC" >>DH0:fumount-eject.result
C:fujinet-mount --status 0 >DH0:fumount-status.result
C:FLS host:/amiga-e2e-complete/diskdevice-fmount >NIL:
C:EndIf
C:Type DH0:fmount-load.result
C:Type DH0:fmount-mount.result
C:Type DH0:fmount-status.result
C:Type DH0:fmount-dir.result
C:Type DH0:fmount-type.result
C:Type DH0:fmount-ab-mount.result
C:Type DH0:fmount-ab-present.result
C:Type DH0:fmount-ab-type.result
C:Type DH0:fmount-ba-mount.result
C:Type DH0:fmount-ba-present.result
C:Type DH0:fmount-ba-type.result
C:Type DH0:fmount-hd-mount.result
C:Type DH0:fmount-hd-dir.result
C:Type DH0:fmount-hd-type.result
C:Type DH0:fmount-hd-dos.result
C:Type DH0:fmount-dd-return-mount.result
C:Type DH0:fmount-dd-return-dir.result
C:Type DH0:fmount-dd-return-type.result
C:Type DH0:fmount-dd-return-dos.result
C:Type DH0:fmount-failed-replace.result
C:Type DH0:fmount-fail-type.result
C:Type DH0:fmount-rw-mount.result
C:Type DH0:fmount-rw-dos-mount.result
C:Type DH0:fmount-rw-copy.result
C:Type DH0:fmount-rw-fumount.result
C:Type DH0:fmount-rw-absent.result
C:Type DH0:fmount-rw-remount.result
C:Type DH0:fmount-rw-present.result
C:Type DH0:fmount-rw-persist.result
C:Type DH0:fmount-rw-status.result
C:Type DH0:fumount-eject.result
C:Type DH0:fumount-status.result
C:Echo "E2E COMPLETE"
