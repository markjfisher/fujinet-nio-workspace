C:Assign T: RAM:
C:LoadModule DEVS:fujinet-disk.device
C:fujinet-mount host:/standard.adf >DH0:dynamic-load.result
C:Mount DN0: FROM DEVS:DN0
C:Echo "STATIC DN0 MOUNT RC=$RC" >DH0:dynamic-static-mount.result
C:Echo "=== BEFORE DYNAMIC NODE ==="
C:dynamicdosnode >DH0:dynamic-node.result
C:Echo "=== AFTER DYNAMIC NODE RC=$RC ==="
C:Echo "=== BEFORE DOSLIST ==="
C:doslistdiag >DH0:dynamic-prestart.result
C:Echo "=== AFTER DOSLIST RC=$RC ==="
C:Echo "=== BEFORE DIR DY0 ==="
C:Dir DY0: >DH0:dynamic-dir.result
C:Echo "DYNAMIC DIR RC=$RC" >DH0:dynamic-dir-rc.result
C:Echo "=== AFTER DIR DY0 RC=$RC ==="
C:doslistdiag >DH0:dynamic-post-dir.result
C:Echo "=== BEFORE TYPE DY0 ==="
C:Type DY0:KNOWN.TXT >DH0:dynamic-type.result
C:Echo "DYNAMIC TYPE RC=$RC" >DH0:dynamic-type-rc.result
C:Echo "=== AFTER TYPE DY0 RC=$RC ==="
C:dynamicdosnode --die >DH0:dynamic-die.result
C:Echo "=== AFTER ACTION DIE RC=$RC ==="
C:doslistdiag --find-only >DH0:dynamic-post-die.result
C:fujinet-mount 14 0 RO >DH0:dynamic-hd-mount.result
C:dynamicdosnode --switch-hd >DH0:dynamic-hd-update.result
C:doslistdiag >DH0:dynamic-hd-prestart.result
C:Echo "=== BEFORE DY0 RESTART DIR ==="
C:Dir DY0: >DH0:dynamic-hd-dir.result
C:Echo "DYNAMIC HD DIR RC=$RC" >DH0:dynamic-hd-dir-rc.result
C:Type DY0:HD.TXT >DH0:dynamic-hd-type.result
C:Echo "DYNAMIC HD TYPE RC=$RC" >DH0:dynamic-hd-type-rc.result
C:doslistdiag --find-only >DH0:dynamic-post-restart.result
C:Echo "=== BEFORE DD RETIREMENT ==="
C:dynamicdosnode --die >DH0:dynamic-dd-die.result
C:Echo "=== AFTER DD RETIREMENT RC=$RC ==="
C:fujinet-mount 11 0 RO >DH0:dynamic-dd-mount.result
C:dynamicdosnode --switch-dd >DH0:dynamic-dd-update.result
C:doslistdiag >DH0:dynamic-dd-prestart.result
C:Echo "=== BEFORE DD RESTART DIR ==="
C:Dir DY0: >DH0:dynamic-dd-dir.result
C:Echo "DYNAMIC DD RESTART DIR RC=$RC" >DH0:dynamic-dd-dir-rc.result
C:Type DY0:KNOWN.TXT >DH0:dynamic-dd-type.result
C:Echo "DYNAMIC DD RESTART TYPE RC=$RC" >DH0:dynamic-dd-type-rc.result
C:doslistdiag --find-only >DH0:dynamic-dd-post-restart.result
C:Echo "RESULTS-BEGIN"
C:Type DH0:dynamic-load.result
C:Type DH0:dynamic-node.result
C:Type DH0:dynamic-static-mount.result
C:Type DH0:dynamic-prestart.result
C:Type DH0:dynamic-dir.result
C:Type DH0:dynamic-dir-rc.result
C:Type DH0:dynamic-post-dir.result
C:Type DH0:dynamic-type.result
C:Type DH0:dynamic-type-rc.result
C:Type DH0:dynamic-die.result
C:Type DH0:dynamic-post-die.result
C:Type DH0:dynamic-hd-mount.result
C:Type DH0:dynamic-hd-update.result
C:Type DH0:dynamic-hd-prestart.result
C:Type DH0:dynamic-hd-dir.result
C:Type DH0:dynamic-hd-dir-rc.result
C:Type DH0:dynamic-hd-type.result
C:Type DH0:dynamic-hd-type-rc.result
C:Type DH0:dynamic-post-restart.result
C:Type DH0:dynamic-dd-die.result
C:Type DH0:dynamic-dd-mount.result
C:Type DH0:dynamic-dd-update.result
C:Type DH0:dynamic-dd-prestart.result
C:Type DH0:dynamic-dd-dir.result
C:Type DH0:dynamic-dd-dir-rc.result
C:Type DH0:dynamic-dd-type.result
C:Type DH0:dynamic-dd-type-rc.result
C:Type DH0:dynamic-dd-post-restart.result
C:Echo "RESULTS-END"
C:FLS host:/amiga-e2e-complete/diskdevice-dynamic-dd >NIL:
C:Echo "E2E COMPLETE"
