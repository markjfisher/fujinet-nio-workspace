C:Assign T: RAM:
C:Echo "Loading Module"
C:LoadModule DEVS:fujinet-disk.device
C:Echo "... Module loaded"
C:Failat 30
C:fujinet-mount --uri 0 host:/standard.adf RO >DH0:fmount.result
C:Echo "STALLED PEER TIMEOUT RC=$RC" >DH0:stalled-peer-timeout.result
C:Failat 10
C:Type DH0:fmount.result
C:Type DH0:stalled-peer-timeout.result
C:Echo "E2E COMPLETE"
