C:Assign T: RAM:
C:LoadModule DEVS:fujinet-disk.device
C:Echo "LOAD RC=$RC" >DH0:map-load.result
C:fujinet-mount --uri 0 host:/standard.adf RO >DH0:map-direct.result
C:Failat 30
C:fujinet-mount 12 0 RO >NIL:
C:Echo "MAPPING FAILURE RC=$RC" >DH0:map-failure.result
C:Failat 10
C:fujinet-mount --status 0 >DH0:map-status.result
C:Type DH0:map-load.result
C:Type DH0:map-direct.result
C:Type DH0:map-failure.result
C:Type DH0:map-status.result
C:Echo "E2E COMPLETE"
