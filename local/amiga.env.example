# local/amiga.env — NOT committed to git.
# Copy this file to local/amiga.env and fill in your paths.
#
# Licensed AmigaOS media paths, plus optional Amiga FTP credentials used by
# `scripts/amiga ftp`. Generated build artifacts (base HDFs, manifest.json)
# are derived from the media paths; you do not configure those manually.

# ---------------------------------------------------------------------------
# AmigaOS Workbench 3.1 (rev 40.42)
#
# Six licensed ADF disk images, identified by role.  Commonly sourced from
# TOSEC archives or original disks; exact filenames vary by archive convention.
# ---------------------------------------------------------------------------
AMIGA_WB31_KICKSTART="/path/to/kick31.rom"
AMIGA_WB31_ROM_KEY="/path/to/rom.key"         # Required if ROM is Amiga Forever encrypted (AMIROMTYPE1)
AMIGA_WB31_ADF_INSTALL="/path/to/workbench31-install.adf"    # Disk 1 — L/FastFileSystem source
AMIGA_WB31_ADF_WORKBENCH="/path/to/workbench31-workbench.adf" # Disk 2 — boot source
AMIGA_WB31_ADF_EXTRAS="/path/to/workbench31-extras.adf"       # Disk 3
AMIGA_WB31_ADF_STORAGE="/path/to/workbench31-storage.adf"     # Disk 4
AMIGA_WB31_ADF_LOCALE="/path/to/workbench31-locale.adf"       # Disk 5
AMIGA_WB31_ADF_FONTS="/path/to/workbench31-fonts.adf"         # Disk 6

# ---------------------------------------------------------------------------
# AmigaOS Workbench 3.2 (Hyperion) — generic media
#
# Two generic ADF disk images used for all machine targets.  Found on the
# Hyperion WB3.2 distribution CD under ADF/.
# ---------------------------------------------------------------------------
AMIGA_WB32_KICKSTART="/path/to/kick32.rom"
AMIGA_WB32_ADF_WORKBENCH="/path/to/amigaOS3.2/ADF/Workbench3.2.adf"   # generic tools, utility libs, serial.device
AMIGA_WB32_ADF_EXTRAS="/path/to/amigaOS3.2/ADF/Extras3.2.adf"          # generic L/ handlers, Prefs, Tools

# ---------------------------------------------------------------------------
# AmigaOS Workbench 3.2 — machine-specific module disks
#
# WB3.2 core OS libraries (graphics.library, intuition.library, exec.library,
# dos.library, etc.) and hardware devices are chipset-specific and ship in
# per-machine Modules ADF files.  Add the variables for each machine you build.
# The variable name is referenced by the machine profile's os_modules section.
# ---------------------------------------------------------------------------
AMIGA_WB32_ADF_MODULES_A1200="/path/to/amigaOS3.2/ADF/ModulesA1200_3.2.adf"
# AMIGA_WB32_ADF_MODULES_A500="/path/to/amigaOS3.2/ADF/ModulesA500_3.2.adf"
# AMIGA_WB32_ADF_MODULES_A2000="/path/to/amigaOS3.2/ADF/ModulesA2000_3.2.adf"

# The variables below are only needed for the wb32-expanded transitional environment.
# They are not required once wb32 is validated and wb32-expanded is retired.
# AMIGA_WB32_ADF="/path/to/amigaOS3.2/ADF/Workbench3.2.adf"
# AMIGA_WB32_EXPANDED="/path/to/expanded-wb32-tree"

# ---------------------------------------------------------------------------
# AmigaOS Workbench 1.3
#
# Used by the wb1.3 workbenches.yaml interactive profile.
# Assembly recipe for automated environments is TBD pending media audit.
# ---------------------------------------------------------------------------
# AMIGA_WB13_KICKSTART="/path/to/kick13.rom"
# AMIGA_WB13_ROM_KEY="/path/to/rom.key"
# AMIGA_WB13_ADF_WORKBENCH="/path/to/amiga-os-134-workbench.adf"

# ---------------------------------------------------------------------------
# Amiga FTP (scripts/amiga ftp)
#
# Used to push built NIO assets to a real Amiga over FTP instead of ADF/Gotek.
# Copy this file to local/amiga.env and replace the placeholders.
# ---------------------------------------------------------------------------
FTP_HOST="203.0.113.64"
FTP_USER="example-user"
FTP_PASS="change-me-not-a-real-password"
FTP_APP="lftp"
