#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

AMIBERRY_BIN=${AMIBERRY_BIN:-amiberry}
AMIBERRY_KICKSTART=${AMIBERRY_KICKSTART:-${HOME}/dev/amiga/amigaOS3.2/ROM/kickCDTVa1000a500a2000a600.rom}
AMIBERRY_FAST_FILE_SYSTEM=${AMIBERRY_FAST_FILE_SYSTEM:-${AMIBERRY_OS_ROOT:-${HOME}/dev/amiga/amigaOS3.2}/L/FastFileSystem}
AMIBERRY_CPU_TYPE=${AMIBERRY_CPU_TYPE:-68000}
AMIBERRY_DISK=${AMIBERRY_DISK:-${AMIGA_TEST_DISK:-}}
AMIBERRY_SERIAL_MODE=${AMIBERRY_SERIAL_MODE:-tcp}
AMIBERRY_HOST=${AMIBERRY_HOST:-127.0.0.1}
AMIBERRY_PORT=${AMIBERRY_PORT:-23462}
FUJINET_NIO_BIN=${FUJINET_NIO_BIN:-$ROOT/repos/fujinet-nio/build/fujibus-tcp-debug/fujinet-nio}
FUJINET_NIO_RS232_BIN=${FUJINET_NIO_RS232_BIN:-$ROOT/repos/fujinet-nio/build/fujibus-rs232-debug/fujinet-nio}
FUJINET_NIO_EXTERNAL=${FUJINET_NIO_EXTERNAL:-0}
FUJINET_HOST=${FUJINET_HOST:-127.0.0.1}
FUJINET_PORT=${FUJINET_PORT:-65504}
AMIGA_RUN_DIR=${AMIGA_RUN_DIR:-$ROOT/build/amiga-e2e}
AMIGA_TIMEOUT=${AMIGA_TIMEOUT:-0}

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Run an AmigaOS 3.2 application in Amiberry against FujiNet NIO.

Options:
  --disk PATH      Bootable Amiga test HDF or ADF
  --timeout SEC    Stop after SEC seconds; 0 means run interactively
  --pty            Use PTYs and fujibus-rs232-debug (experimental)
  --tcp            Use Amiberry TCP serial and fujibus-tcp-debug (default)
  --nio-port PORT  FujiNet NIO TCP server port
  --amiga-port PORT Amiberry TCP serial listener port
  --external-nio   Use an already-running FujiNet NIO on --nio-port
  --help           Show this help

Environment: AMIBERRY_BIN AMIBERRY_KICKSTART FUJINET_NIO_BIN AMIGA_RUN_DIR
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --adf|--disk) AMIBERRY_DISK=$2; shift 2 ;;
        --timeout) AMIGA_TIMEOUT=$2; shift 2 ;;
        --pty) AMIBERRY_SERIAL_MODE=pty; shift ;;
        --tcp) AMIBERRY_SERIAL_MODE=tcp; shift ;;
        --nio-port) FUJINET_PORT=$2; shift 2 ;;
        --amiga-port) AMIBERRY_PORT=$2; shift 2 ;;
        --external-nio) FUJINET_NIO_EXTERNAL=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

case "$AMIBERRY_SERIAL_MODE" in
    pty)
        FUJINET_NIO_BIN=${FUJINET_NIO_RS232_BIN}
        if [[ "$FUJINET_NIO_EXTERNAL" != 0 ]]; then
            echo "--external-nio is only supported with --tcp" >&2
            exit 2
        fi
        ;;
    tcp) ;;
    *) echo "Unknown Amiberry serial mode: $AMIBERRY_SERIAL_MODE" >&2; exit 2 ;;
esac

require_file() {
    if [[ ! -f "$1" ]]; then
        echo "Required file not found: $1" >&2
        exit 1
    fi
}

command -v "$AMIBERRY_BIN" >/dev/null 2>&1 || { echo "Amiberry not found: $AMIBERRY_BIN" >&2; exit 1; }
command -v socat >/dev/null 2>&1 || { echo "socat is required for the serial bridge" >&2; exit 1; }
require_file "$AMIBERRY_KICKSTART"
require_file "$AMIBERRY_FAST_FILE_SYSTEM"
if [[ "$FUJINET_NIO_EXTERNAL" == 0 ]]; then
    require_file "$FUJINET_NIO_BIN"
fi
[[ -n "$AMIBERRY_DISK" ]] || { echo "An Amiga disk is required; use --disk PATH" >&2; exit 1; }
require_file "$AMIBERRY_DISK"

mkdir -p "$AMIGA_RUN_DIR"
ROM_DIR="$AMIGA_RUN_DIR/rom"
mkdir -p "$ROM_DIR"
cp "$AMIBERRY_KICKSTART" "$ROM_DIR/kickstart.rom"
cp "$AMIBERRY_FAST_FILE_SYSTEM" "$ROM_DIR/FastFileSystem"
NIO_LOG=${NIO_LOG:-$AMIGA_RUN_DIR/fujinet-nio.log}
AMIBERRY_LOG=${AMIBERRY_LOG:-$AMIGA_RUN_DIR/amiberry.log}
BRIDGE_LOG=${BRIDGE_LOG:-$AMIGA_RUN_DIR/bridge.log}
CONFIG_DIR="$AMIGA_RUN_DIR/fujinet-data"
mkdir -p "$CONFIG_DIR"
cat > "$CONFIG_DIR/fujinet.yaml" <<EOF
fujinet:
  device_name: amiga-test
wifi:
  enabled: false
  ssid: ""
  passphrase: ""
channel:
  tcp_host: "$FUJINET_HOST"
  tcp_port: $FUJINET_PORT
EOF

NIO_PID=
AMIBERRY_PID=
BRIDGE_PID=
AMIGA_PTY="$AMIGA_RUN_DIR/amiga-serial"
NIO_PTY="$AMIGA_RUN_DIR/nio-serial"
cleanup() {
    set +e
    for pid in "$BRIDGE_PID" "$AMIBERRY_PID" "$NIO_PID"; do
        [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    done
    wait "$BRIDGE_PID" "$AMIBERRY_PID" "$NIO_PID" 2>/dev/null || true
    rm -f "$AMIGA_PTY" "$NIO_PTY"
}
trap cleanup EXIT INT TERM

if [[ "$AMIBERRY_SERIAL_MODE" == pty ]]; then
    rm -f "$AMIGA_PTY" "$NIO_PTY"
    echo "Creating Amiga serial PTY pair"
    BRIDGE_ARGS=(-d -d)
    if [[ "${SOCAT_HEXDUMP:-0}" == 1 ]]; then
        BRIDGE_ARGS+=(-x -v)
    fi
    socat "${BRIDGE_ARGS[@]}" \
        "pty,raw,echo=0,link=$AMIGA_PTY" \
        "pty,raw,echo=0,link=$NIO_PTY" >"$BRIDGE_LOG" 2>&1 &
    BRIDGE_PID=$!
    for _ in $(seq 1 100); do
        [[ -L "$AMIGA_PTY" && -L "$NIO_PTY" ]] && break
        sleep 0.1
    done
    [[ -L "$AMIGA_PTY" && -L "$NIO_PTY" ]] || { echo "Serial PTYs were not created" >&2; exit 1; }
    AMIGA_SERIAL_DEVICE=$(readlink "$AMIGA_PTY")
    NIO_SERIAL_DEVICE=$(readlink "$NIO_PTY")
    echo "Amiga PTY: $AMIGA_PTY"
    echo "NIO PTY:   $NIO_PTY"
    echo "Amiga device: $AMIGA_SERIAL_DEVICE"
    echo "NIO device:   $NIO_SERIAL_DEVICE"
elif [[ "$FUJINET_NIO_EXTERNAL" == 0 ]]; then
    echo "Starting FujiNet NIO on $FUJINET_HOST:$FUJINET_PORT"
    (cd "$CONFIG_DIR" && "$FUJINET_NIO_BIN") >"$NIO_LOG" 2>&1 &
    NIO_PID=$!
else
    echo "Using existing FujiNet NIO on $FUJINET_HOST:$FUJINET_PORT"
fi

if [[ "$AMIBERRY_SERIAL_MODE" == tcp ]]; then
    for _ in $(seq 1 100); do
        if nc -z "$FUJINET_HOST" "$FUJINET_PORT" 2>/dev/null; then break; fi
        sleep 0.1
    done
    nc -z "$FUJINET_HOST" "$FUJINET_PORT" 2>/dev/null || { echo "FujiNet NIO is not listening on $FUJINET_HOST:$FUJINET_PORT" >&2; exit 1; }
fi

if [[ "$AMIBERRY_SERIAL_MODE" == pty ]]; then
    echo "Starting FujiNet NIO RS232 profile"
    (cd "$CONFIG_DIR" && FN_SERIAL_PORT="$NIO_SERIAL_DEVICE" FN_SERIAL_BAUD=19200 "$FUJINET_NIO_BIN") >"$NIO_LOG" 2>&1 &
    NIO_PID=$!
fi

echo "Starting Amiberry with $AMIBERRY_DISK"
DISK_ARGS=(-0 "$AMIBERRY_DISK")
if [[ "$AMIBERRY_DISK" == *.hdf ]]; then
    DISK_ARGS=(-W "DH0:$AMIBERRY_DISK")
fi
"$AMIBERRY_BIN" --log -G \
    -r "$ROM_DIR/kickstart.rom" \
    "${DISK_ARGS[@]}" \
    -s "serial_port=$([[ "$AMIBERRY_SERIAL_MODE" == pty ]] && printf '%s' "$AMIGA_SERIAL_DEVICE" || printf 'tcp://%s:%s' "$AMIBERRY_HOST" "$AMIBERRY_PORT")" \
    -s serial_hardware_ctsrts=false \
    -s serial_status=false \
    -s serial_direct=true \
    -s "cpu_type=$AMIBERRY_CPU_TYPE" \
    -s cpu_compatible=true \
    -s cachesize=0 >"$AMIBERRY_LOG" 2>&1 &
AMIBERRY_PID=$!

if [[ "$AMIBERRY_SERIAL_MODE" == tcp ]]; then
    for _ in $(seq 1 100); do
        if nc -z "$AMIBERRY_HOST" "$AMIBERRY_PORT" 2>/dev/null; then break; fi
        sleep 0.1
    done
    nc -z "$AMIBERRY_HOST" "$AMIBERRY_PORT" 2>/dev/null || { echo "Amiberry did not open its TCP serial port" >&2; exit 1; }
    echo "Bridging Amiberry TCP to FujiNet NIO TCP"
    BRIDGE_ARGS=(-d -d)
    if [[ "${SOCAT_HEXDUMP:-0}" == 1 ]]; then
        BRIDGE_ARGS+=(-x -v)
    fi
    socat "${BRIDGE_ARGS[@]}" "TCP:$AMIBERRY_HOST:$AMIBERRY_PORT" "TCP:$FUJINET_HOST:$FUJINET_PORT" >"$BRIDGE_LOG" 2>&1 &
    BRIDGE_PID=$!
fi

if [[ "$AMIGA_TIMEOUT" != 0 ]]; then
    timeout --signal=TERM "$AMIGA_TIMEOUT" tail --pid="$AMIBERRY_PID" -f /dev/null || true
else
    wait "$AMIBERRY_PID"
fi

echo "Amiberry logs: $AMIBERRY_LOG"
echo "FujiNet NIO logs: $NIO_LOG"
echo "Bridge logs: $BRIDGE_LOG"
