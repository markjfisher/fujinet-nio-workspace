#!/usr/bin/env python3
"""Create a bootable Amiga HDF from a licensed expanded AmigaOS tree."""

from __future__ import annotations

import argparse
import shutil
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))

from amiga_emulator.disk import (
    extract_archive,
    install_tree,
    run_xdf,
    run_xdf_optional,
    startup_command_offset,
    validate_volume_label,
)


def ignored_cd_content(_directory: str, names: list[str]) -> set[str]:
    ignored = {"ADF", "GlowIconsCollection", "Labels", "ROM"}
    for name in names:
        if name in ignored:
            ignored.add(name)
            continue
        try:
            name.encode("latin-1")
        except UnicodeEncodeError:
            ignored.add(name)
    return ignored


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)

    source_group = parser.add_mutually_exclusive_group(required=True)
    source_group.add_argument(
        "--base-hdf", type=Path,
        help="pre-built base HDF (from scripts/amiga-env build); copied then test payload injected",
    )
    source_group.add_argument(
        "--os-root", type=Path,
        help="(legacy) expanded AmigaOS tree; packed into a fresh HDF each run",
    )

    parser.add_argument("--boot-adf", type=Path,
                        help="(legacy, required with --os-root) boot-block + serial.device source ADF")
    parser.add_argument("--app", required=True, type=Path)
    parser.add_argument("--app-name", default="wifitest")
    parser.add_argument("--extra-app-dir", action="append", type=Path, default=[],
                        help="directory of additional executables to install in C:")
    parser.add_argument("--install-archive", action="append", type=Path, default=[],
                        help="extract an LHA/archive tree into the disk root")
    parser.add_argument("--disk-device", type=Path,
                        help="native fujinet-disk.device to install in DEVS:")
    parser.add_argument("--resident-loader", type=Path,
                        help="resident module loader to install in C:")
    parser.add_argument("--load-driver", action="store_true",
                        help="load fujinet-disk.device during startup")
    parser.add_argument("--disk-mount-tool", type=Path,
                        help="fujinet-mount command to install in C:")
    parser.add_argument("--disk-mountlist", action="append", type=Path,
                        default=[], help="DNx MountList entry to install in DEVS:")
    parser.add_argument("--command", default=None,
                        help="startup command; defaults to the installed app name")
    parser.add_argument("--startup-script", type=Path,
                        help="complete Startup-Sequence to install instead of generating one")
    parser.add_argument("--interactive", action="store_true",
                        help="preserve the OS startup sequence for interactive use")
    parser.add_argument("--no-workbench", action="store_true",
                        help="run the startup test in the CLI and stop before LoadWB")
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--size", default="128M")
    parser.add_argument(
        "--volume-label",
        help="Amiga volume label; only used with --os-root (defaults to the OS tree directory name)",
    )
    args = parser.parse_args()

    if args.os_root is not None and args.boot_adf is None:
        raise SystemExit("--boot-adf is required when using --os-root")
    if args.base_hdf is not None and args.boot_adf is not None:
        raise SystemExit("--boot-adf is not used with --base-hdf (boot block is already in the base HDF)")
    if args.base_hdf is not None and not args.base_hdf.is_file():
        raise SystemExit(f"base HDF not found: {args.base_hdf}")
    if args.os_root is not None and not args.os_root.is_dir():
        raise SystemExit(f"expanded AmigaOS tree not found: {args.os_root}")
    if args.boot_adf is not None and not args.boot_adf.is_file():
        raise SystemExit(f"boot-block source ADF not found: {args.boot_adf}")
    if not args.app.is_file():
        raise SystemExit(f"application not found: {args.app}")
    for app_dir in args.extra_app_dir:
        if not app_dir.is_dir():
            raise SystemExit(f"additional Amiga application directory not found: {app_dir}")
    for archive in args.install_archive:
        if not archive.is_file():
            raise SystemExit(f"installation archive not found: {archive}")
    for path, label in ((args.disk_device, "disk device"),
                        (args.resident_loader, "resident loader"),
                        (args.disk_mount_tool, "disk mount tool"),
                        ):
        if path is not None and not path.is_file():
            raise SystemExit(f"{label} not found: {path}")
    if args.load_driver and (args.disk_device is None or args.resident_loader is None):
        raise SystemExit(
            "--load-driver requires --disk-device and --resident-loader"
        )
    for path in args.disk_mountlist:
        if not path.is_file():
            raise SystemExit(f"disk MountList not found: {path}")

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.unlink(missing_ok=True)

    with tempfile.TemporaryDirectory(prefix="amiga-test-disk-") as temp:

        if args.base_hdf is not None:
            # ---------------------------------------------------------------
            # New path: copy the pre-built base HDF and inject test payload.
            # Boot block and serial.device are already in the base HDF.
            # ---------------------------------------------------------------
            shutil.copy2(args.base_hdf, args.output)

            # Read the Startup-Sequence from the copied image so we can splice
            # test commands into it at the LoadWB marker, exactly as the legacy
            # path does from the staged OS tree.
            ss_local = Path(temp) / "Startup-Sequence"
            _extracted = False
            for ss_name in ("S/Startup-Sequence", "S/Startup-sequence"):
                try:
                    run_xdf(args.output, "read", ss_name, str(ss_local))
                    _extracted = True
                    break
                except SystemExit:
                    pass
            if not _extracted:
                raise SystemExit("Could not read S/Startup-Sequence from base HDF")
            original = ss_local.read_text(encoding="latin-1")
            staged_startup: str | None = original  # used below in shared payload injection

        else:
            # ---------------------------------------------------------------
            # Legacy path: pack a fresh HDF from the expanded OS tree.
            # ---------------------------------------------------------------
            try:
                volume_label = validate_volume_label(
                    args.volume_label or args.os_root.resolve().name  # type: ignore[union-attr]
                )
            except ValueError as exc:
                raise SystemExit(str(exc)) from exc

            staged_os = Path(temp) / volume_label
            shutil.copytree(args.os_root, staged_os, ignore=ignored_cd_content)
            run_xdf(args.output, "pack", str(staged_os), "ffs", f"size={args.size}")
            run_xdf_optional(args.output, "delete", "WBStartup/Welcome")
            run_xdf_optional(args.output, "delete", "WBStartup/Welcome.info")
            boot_code = Path(temp) / "boot.bin"
            run_xdf(args.boot_adf, "boot", "read", str(boot_code))
            run_xdf(args.output, "boot", "write", str(boot_code))
            serial_device = Path(temp) / "serial.device"
            run_xdf(args.boot_adf, "read", "Devs/serial.device", str(serial_device))
            run_xdf_optional(args.output, "delete", "Devs/serial.device")
            run_xdf(args.output, "write", str(serial_device), "Devs/serial.device")

            startup_source = staged_os / "S" / "Startup-sequence"
            if not startup_source.is_file():
                startup_source = staged_os / "S" / "Startup-Sequence"
            staged_startup = startup_source.read_text(encoding="latin-1")

        # -------------------------------------------------------------------
        # Shared: install test payload (app, driver, startup modifications).
        # Applies to both --base-hdf and --os-root modes.
        # -------------------------------------------------------------------
        run_xdf(args.output, "write", str(args.app), f"C/{args.app_name}")
        if args.disk_device:
            run_xdf(args.output, "write", str(args.disk_device),
                    "Devs/fujinet-disk.device")
        if args.resident_loader:
            run_xdf(args.output, "write", str(args.resident_loader),
                    "C/fujinet-load-resident")
        if args.disk_mount_tool:
            run_xdf(args.output, "write", str(args.disk_mount_tool),
                    "C/fujinet-mount")
        for mountlist in args.disk_mountlist:
            run_xdf(args.output, "write", str(mountlist),
                    f"Devs/{mountlist.name}")
        installed_names = {args.app_name}
        for app_dir in args.extra_app_dir:
            for app in sorted(app_dir.iterdir()):
                if not app.is_file() or app.name in installed_names:
                    continue
                run_xdf(args.output, "write", str(app), f"C/{app.name}")
                installed_names.add(app.name)
        for index, archive in enumerate(args.install_archive):
            archive_root = Path(temp) / f"archive-{index}"
            extract_archive(archive, archive_root)
            install_tree(args.output, archive_root)

        if args.startup_script or not args.interactive or args.load_driver:
            if args.startup_script:
                if not args.startup_script.is_file():
                    raise SystemExit(f"startup script not found: {args.startup_script}")
                test_commands = args.startup_script.read_text(encoding="ascii")
            elif args.interactive:
                test_commands = ""
            else:
                command = args.command or args.app_name
                test_commands = (
                    "C:Assign T: RAM:\n"
                    f"C:{command} >DH0:{args.app_name}.result\n"
                )
            if args.load_driver:
                test_commands = (
                    "C:fujinet-load-resident "
                    "DEVS:fujinet-disk.device fujinet-disk.device\n"
                    + test_commands
                )

            # Keep the licensed Workbench startup preamble.  It creates and
            # assigns ENV: and T:, installs the normal command path, and only
            # then should our test commands run.  Replacing it makes AmigaOS
            # request the missing ENV volume during boot.
            original = staged_startup  # type: ignore[assignment]
            marker_at = startup_command_offset(original, "LoadWB")
            if marker_at is None:
                raise SystemExit(
                    "licensed Startup-Sequence has no LoadWB command line"
                )
            startup_text = original[:marker_at] + test_commands.rstrip() + "\n"
            if args.no_workbench:
                # Protocol tests do not need Workbench.  End the boot CLI
                # after the test so the guest remains a small, fast console
                # environment and does not spend time loading the desktop.
                startup_text += "C:Wait 1\nC:EndCLI\n"
            else:
                startup_text += original[marker_at:]
            startup = Path(temp) / "Startup-Sequence-patched"
            startup.write_text(startup_text, encoding="latin-1")
            run_xdf(args.output, "delete", "S/Startup-Sequence")
            run_xdf(args.output, "write", str(startup), "S/Startup-Sequence")

    print(f"Built Amiga test HDF: {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
