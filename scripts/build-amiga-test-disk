#!/usr/bin/env python3
"""Create a bootable Amiga HDF from a licensed expanded AmigaOS tree."""

from __future__ import annotations

import argparse
import shutil
import subprocess
import tempfile
from pathlib import Path


def xdf_tool() -> list[str]:
    tool = shutil.which("xdftool")
    if tool:
        return [tool]
    uvx = shutil.which("uvx")
    if uvx:
        return [uvx, "--from", "amitools", "xdftool"]
    raise SystemExit("xdftool is required, or install uv/uvx to fetch amitools")


def run_xdf(image: Path, *commands: str) -> None:
    subprocess.run([*xdf_tool(), str(image), *commands], check=True)


def ignored_cd_content(_directory: str, names: list[str]) -> set[str]:
    ignored = {"ADF", "GlowIconsCollection", "Labels", "ROM"}
    for name in names:
        if name in ignored:
            ignored.add(name)
            continue
        try:
            name.encode("latin-1")
        except UnicodeEncodeError:
            ignored.add(name)
    return ignored


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--os-root", required=True, type=Path)
    parser.add_argument("--boot-adf", required=True, type=Path)
    parser.add_argument("--app", required=True, type=Path)
    parser.add_argument("--app-name", default="wifitest")
    parser.add_argument("--extra-app-dir", action="append", type=Path, default=[],
                        help="directory of additional executables to install in C:")
    parser.add_argument("--disk-device", type=Path,
                        help="native fujinet-disk.device to install in DEVS:")
    parser.add_argument("--load-driver", action="store_true",
                        help="load fujinet-disk.device during startup")
    parser.add_argument("--disk-mount-tool", type=Path,
                        help="fujinet-mount command to install in C:")
    parser.add_argument("--disk-mountlist", action="append", type=Path,
                        default=[], help="DNx MountList entry to install in DEVS:")
    parser.add_argument("--command", default=None,
                        help="startup command; defaults to the installed app name")
    parser.add_argument("--startup-script", type=Path,
                        help="complete Startup-Sequence to install instead of generating one")
    parser.add_argument("--interactive", action="store_true",
                        help="preserve the OS startup sequence for interactive use")
    parser.add_argument("--no-workbench", action="store_true",
                        help="run the startup test in the CLI and stop before LoadWB")
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--size", default="128M")
    args = parser.parse_args()

    if not args.os_root.is_dir():
        raise SystemExit(f"expanded AmigaOS tree not found: {args.os_root}")
    if not args.boot_adf.is_file():
        raise SystemExit(f"boot-block source ADF not found: {args.boot_adf}")
    if not args.app.is_file():
        raise SystemExit(f"application not found: {args.app}")
    for app_dir in args.extra_app_dir:
        if not app_dir.is_dir():
            raise SystemExit(f"additional Amiga application directory not found: {app_dir}")
    for path, label in ((args.disk_device, "disk device"),
                        (args.disk_mount_tool, "disk mount tool"),
                        ):
        if path is not None and not path.is_file():
            raise SystemExit(f"{label} not found: {path}")
    for path in args.disk_mountlist:
        if not path.is_file():
            raise SystemExit(f"disk MountList not found: {path}")

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.unlink(missing_ok=True)

    with tempfile.TemporaryDirectory(prefix="amiga-test-disk-") as temp:
        staged_os = Path(temp) / "AmigaOS3.2"
        shutil.copytree(args.os_root, staged_os, ignore=ignored_cd_content)
        run_xdf(args.output, "pack", str(staged_os), "ffs", f"size={args.size}")
        # The licensed Workbench tree includes a first-run WBStartup program
        # which opens a "Welcome to the Amiga Preinstallation Environment"
        # requester.  Test images should boot directly to an usable
        # Workbench; remove only this optional welcome program, not the rest
        # of WBStartup.
        run_xdf(args.output, "delete", "WBStartup/Welcome")
        run_xdf(args.output, "delete", "WBStartup/Welcome.info")
        boot_code = Path(temp) / "boot.bin"
        run_xdf(args.boot_adf, "boot", "read", str(boot_code))
        run_xdf(args.output, "boot", "write", str(boot_code))
        serial_device = Path(temp) / "serial.device"
        run_xdf(args.boot_adf, "read", "Devs/serial.device", str(serial_device))
        run_xdf(args.output, "write", str(serial_device), "Devs/serial.device")
        run_xdf(args.output, "write", str(args.app), f"C/{args.app_name}")
        if args.disk_device:
            run_xdf(args.output, "write", str(args.disk_device),
                    "Devs/fujinet-disk.device")
        if args.disk_mount_tool:
            run_xdf(args.output, "write", str(args.disk_mount_tool),
                    "C/fujinet-mount")
        for mountlist in args.disk_mountlist:
            run_xdf(args.output, "write", str(mountlist),
                    f"Devs/{mountlist.name}")
        installed_names = {args.app_name}
        for app_dir in args.extra_app_dir:
            for app in sorted(app_dir.iterdir()):
                if not app.is_file() or app.name in installed_names:
                    continue
                run_xdf(args.output, "write", str(app), f"C/{app.name}")
                installed_names.add(app.name)
        if args.startup_script or not args.interactive or args.load_driver:
            if args.startup_script:
                if not args.startup_script.is_file():
                    raise SystemExit(f"startup script not found: {args.startup_script}")
                test_commands = args.startup_script.read_text(encoding="ascii")
            elif args.interactive:
                test_commands = ""
            else:
                command = args.command or args.app_name
                test_commands = (
                    "C:Assign T: RAM:\n"
                    f"C:{command} >DH0:{args.app_name}.result\n"
                )
            if args.load_driver:
                test_commands = (
                    "C:LoadModule DEVS:fujinet-disk.device\n"
                    + test_commands
                )

            # Keep the licensed Workbench startup preamble.  It creates and
            # assigns ENV: and T:, installs the normal command path, and only
            # then should our test commands run.  Replacing it makes AmigaOS
            # request the missing ENV volume during boot.
            startup_source = staged_os / "S" / "Startup-sequence"
            if not startup_source.is_file():
                startup_source = staged_os / "S" / "Startup-Sequence"
            original = startup_source.read_text(encoding="latin-1")
            marker = "LoadWB"
            marker_at = original.find(marker)
            if marker_at < 0:
                raise SystemExit("licensed Startup-Sequence has no LoadWB marker")
            startup_text = original[:marker_at] + test_commands.rstrip() + "\n"
            if args.no_workbench:
                # Protocol tests do not need Workbench.  End the boot CLI
                # after the test so the guest remains a small, fast console
                # environment and does not spend time loading the desktop.
                startup_text += "C:Wait 1\nC:EndCLI\n"
            else:
                startup_text += original[marker_at:]
            startup = Path(temp) / "Startup-Sequence"
            startup.write_text(startup_text, encoding="latin-1")
            run_xdf(args.output, "delete", "S/Startup-Sequence")
            run_xdf(args.output, "write", str(startup), "S/Startup-Sequence")

    print(f"Built Amiga test HDF: {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
