#!/usr/bin/env bash
# Run the Amiberry integration test suite against a selected AmigaOS environment.
#
# Usage:
#   scripts/amiga-tests [--amiga-env ENV] [--amiga-machine MACHINE] [pytest-args...]
#
# Convenience wrapper around:
#   uv run --directory integration-tests/amiberry pytest --run-amiga \
#     [--amiga-env ENV] [--amiga-machine MACHINE] [pytest-args...]
#
# If --amiga-env is not given, pytest uses its configured default.
# Any additional arguments are forwarded to pytest verbatim.
# Relative paths (test nodes and pytest options such as --junitxml) are
# resolved from integration-tests/amiberry. Use absolute output paths when
# a report should be written elsewhere.

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SUITE="$ROOT/integration-tests/amiberry"

source "$ROOT/scripts/env.sh"

# Run inside the suite so relative test nodes resolve and pytest's testpaths
# supplies the full suite when no node is named.
exec uv run --directory "$SUITE" pytest --run-amiga "$@"
